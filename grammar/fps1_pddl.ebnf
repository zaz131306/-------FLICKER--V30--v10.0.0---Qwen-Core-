                        (not (free ?c))
                        (or (free ?c) (exists (?d - container) (free ?d)))
                        (forall (?o - obj) (not (broken ?o)))))
    (:effect (and (not (sealed ?c))
                  (forall (?o - obj) (when (fragile ?o) (inside ?o ?c))))))
)
*)


(* ==========================================================================
   ПРИЛОЖЕНИЕ Б.2 — ОТРИЦАТЕЛЬНЫЕ ВЕКТОРЫ
   Грамматика ОБЯЗАНА не порождать следующее. Если бэкенд допускает
   любую из этих конструкций — барьер B1 не работает, критерий A1 провален.
   ========================================================================== *)

(* Б.2.1  Числовой флюент — вне FPS-1
  (:requirements :fluents)
  (:function (cost ?c - city))
  (:effect (increase (total-cost) 10))
*)

(* Б.2.2  Дизъюнктивный эффект — вне FPS-1
  (:effect (or (at ?p ?l1) (at ?p ?l2)))
*)

(* Б.2.3  Равенство — вне FPS-1
  (:precondition (= ?x ?y))
*)

(* Б.2.4  Темпоральность — вне FPS-1
  (:durative-action move
    (:duration (= ?duration 5))
    (:condition (at start (at ?v ?l1))))
*)

(* Б.2.5  Вероятностный эффект — вне FPS-1, принципиально
  (:effect (probabilistic 0.8 (at ?p ?l2) 0.2 (at ?p ?l3)))
*)

(* Б.2.6  Неподдерживаемый requirement
  (:requirements :strips :adl)
*)

(* ==========================================================================
   КОНЕЦ ПРИЛОЖЕНИЯ Б
   ========================================================================== *)
