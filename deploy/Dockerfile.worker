# FLICKER V30 · Том 2 — Python worker
#
# НУЛЕВАЯ зависимость от pip-пакетов (§14.2): HTTP через stdlib urllib,
# хэши через hashlib, JSON через json. Это сохраняет воспроизводимость
# установки в изолированном контуре и не создаёт supply-chain риска.
#
# Веса моделей в образ НЕ входят: монтируются read-only, хэш сверяется
# с configs/model_pin.yaml (R5.2.3).

FROM python:3.11-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates tini curl \
    && rm -rf /var/lib/apt/lists/* \
 && groupadd --system flicker \
 && useradd  --system --gid flicker --home /opt/flicker --shell /usr/sbin/nologin flicker

WORKDIR /opt/flicker

# Ядро нужно воркеру как внешний бинарник: гарантии G1–G4 обеспечиваются
# Rust-ядром, а не Python-кодом (§4.1). Копируем из build-образа ядра.
COPY --from=flicker-supervisor:local /usr/local/bin/flicker-plan /usr/local/bin/flicker-plan

COPY worker/flicker_worker /opt/flicker/flicker_worker
COPY worker/pyproject.toml /opt/flicker/pyproject.toml
COPY worker/tests          /opt/flicker/tests
COPY grammar  /opt/flicker/grammar
COPY domains  /opt/flicker/domains
COPY configs  /opt/flicker/configs

# bwrap + libseccomp для IEP (§9, R9.1–R9.3). Без них изоляция
# недоверенного кода невозможна — пакет ставится, даже если P0-профиль
# запускается без IEP.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bubblewrap libseccomp2 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FLICKER_PLAN_BIN=/usr/local/bin/flicker-plan \
    FLICKER_SUPERVISOR_SOCK=/run/flicker/supervisor.sock

RUN mkdir -p /run/flicker /var/log/flicker /var/lib/flicker \
 && chown -R flicker:flicker /run/flicker /var/log/flicker /var/lib/flicker /opt/flicker

USER flicker

# Воркер обязан пройти selftest при старте: он проверяет доступность ядра,
# загружаемость грамматики и сквозной конвейер на офлайн-бэкенде.
HEALTHCHECK --interval=30s --timeout=15s --start-period=10s --retries=3 \
  CMD ["python3", "-m", "flicker_worker", "selftest", "--json"]

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "flicker_worker", "--help"]
